# App
APP_NAME=DataMarket
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=datasets
SUPABASE_SAMPLE_BUCKET=samples
SIGNED_URL_EXPIRY_SECONDS=3600

# Upload limits
MAX_UPLOAD_SIZE_MB=500
SAMPLE_ROWS=50

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Brevo) — optional; free report + emails degrade gracefully if unset
BREVO_API_KEY=
BREVO_QUALITY_REPORT_LIST_ID=0

# Free Quality Report (public lead magnet)
REPORT_MAX_UPLOAD_MB=100
FREE_REPORTS_PER_EMAIL_PER_MONTH=5
FREE_REPORTS_PER_IP_PER_HOUR=10
FRONTEND_URL=http://localhost:3000

# Dataset Chatbot (Premium pre-purchase Q&A) — provider is swappable
CHAT_PROVIDER=groq
CHAT_RATE_LIMIT_PER_HOUR=40
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternatives (one-value switch): MISTRAL_API_KEY / MISTRAL_MODEL, or CHAT_PROVIDER=ollama + OLLAMA_BASE_URL

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
